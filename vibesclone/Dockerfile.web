# syntax=docker/dockerfile:1
FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm" PATH="/pnpm:$PATH" NEXT_TELEMETRY_DISABLED=1
RUN corepack enable

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM base AS build
WORKDIR /app
ARG RAILWAY_GIT_COMMIT_SHA=unknown
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN printf '%s\n' "$RAILWAY_GIT_COMMIT_SHA" > BUILD_SOURCE_SHA
RUN pnpm build

FROM node:22-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/* && npm install -g prisma@6.19.3
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/BUILD_SOURCE_SHA ./BUILD_SOURCE_SHA
COPY docker-entrypoint.web.sh ./docker-entrypoint.web.sh
RUN chmod +x docker-entrypoint.web.sh
EXPOSE 3000
CMD ["./docker-entrypoint.web.sh"]
