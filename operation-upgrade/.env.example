# Postgres. Railway injects this automatically when a Postgres plugin is attached.
DATABASE_URL="postgresql://localhost:5432/operation_upgrade"

# The word students type to get in. Put it on the projector.
# One per section, comma separated, as CODE:SECTION pairs.
JOIN_CODES="bharat-a:A,bharat-b:B,bharat-c:C,bharat-d:D,bharat-e:E,bharat-f:F,bharat-g:G,bharat-h:H"

# Anything typed here unlocks the instructor console and the wall display.
FACILITATOR_KEY="change-me-before-class"
