# syntax=docker/dockerfile:1
# Demo image: the production standalone build (Dockerfile.web) plus the demo
# seed tooling. Boots fast and reliably like production (next start standalone),
# but seeds a fresh DB and permits the test-login backdoor (DEMO_MODE=1). This
# exists ONLY for the disposable demo instance; real production uses
# Dockerfile.web (no seed, no test-login).
#
#   docker build -f Dockerfile.demo -t praxel-demo .

FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH" \
    NEXT_TELEMETRY_DISABLED=1
RUN corepack enable

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM base AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm prisma generate
RUN pnpm build

FROM node:22-slim AS runtime
# openssl: Prisma engines on debian-slim. prisma + tsx installed globally to run
# migrate deploy and the tsx seed at container start.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g prisma@6.19.3 tsx@4.23.1
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
# Next standalone output: server.js + minimal node_modules (includes the Prisma
# client + engine). Static assets and public/ are copied alongside.
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
# Schema + migrations for migrate deploy; seed sources for the boot seeder.
COPY prisma ./prisma
COPY lib/seed-utils.ts ./lib/seed-utils.ts
COPY docker-entrypoint.demo.sh ./docker-entrypoint.demo.sh
RUN chmod +x ./docker-entrypoint.demo.sh
EXPOSE 3000
CMD ["./docker-entrypoint.demo.sh"]
