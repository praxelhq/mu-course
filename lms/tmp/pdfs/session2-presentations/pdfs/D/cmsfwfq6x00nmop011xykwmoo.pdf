cial Media": 101, "Utilities": 41};\nvar TM_Z = {"AI": 14.8, "Analytics": 9.9, "Content Creation": 14.0, "Customer Support": 9.5, "Design Tools": 21.9, "Dev Tools": 13.7, "E-comm": 16.1, "Education": 12.5, "Entertainment": 19.1, "Fintech": 19.2, "Games": 11.1, "Health & Fitness": 14.9, "Marketing": 13.8, "Mobile Apps": 12.8, "Productivity": 13.8, "SaaS": 13.5, "Sales": 7.1, "Social Media": 14.9, "Utilities": 12.2};\nvar TM_D = [[7,24.5],[30,40.0],[90,54.9],[365,72.8]];\nvar TM_A = {"B2B":2.63,"B2C":0.64};\nfunction TM_pct\(d\){\n  if \(d <= TM_D[0][0]\) return TM_D[0][1];\n  for \(var i=0; i<TM_D.length-1; i++\){\n    var a=TM_D[i], b=TM_D[i+1];\n    if \(d <= b[0]\) { var t=\(d-a[0]\)/\(b[0]-a[0]\); return a[1]+t*\(b[1]-a[1]\); }\n  }\n  return TM_D[TM_D.length-1][1];\n}\nfunction TM_q\(cat,p\){\n  var a = TM_Q[cat]; if \(!a\) return 0;\n  var i = p/2; if \(i<0\) i=0; if \(i>50\) i=50;\n  var lo = Math.floor\(i\), hi = Math.min\(50, lo+1\);\n  return a[lo] + \(a[hi]-a[lo]\)*\(i-lo\);\n}\nfunction TM_money\(v\){\n  if \(v >= 1000000\) return "$" + \(v/1000000\).toFixed\(1\) + "M";\n  if \(v >= 10000\)   return "$" + Math.round\(v/1000\) + "k";\n  if \(v >= 1000\)    return "$" + \(v/1000\).toFixed\(1\) + "k";\n  return "$" + Math.round\(v\);\n}\nfunction TM_state\(doc\){\n  var cat = doc.getField\("tm_cat"\).value;\n  var day = parseInt\(doc.getField\("tm_days"\).value, 10\);\n  var aud = doc.getField\("tm_aud"\).value;\n  if \(!TM_Q[cat]\) cat = "SaaS";\n  if \(isNaN\(day\)\) day = 90;\n  var m = TM_A[aud]; if \(!m\) m = 2.63;\n  var p = TM_pct\(day\);\n  return { cat:cat, day:day, p:p,\n           lo: TM_q\(cat, Math.max\(1,  p-16\)\) * m,\n           mid:TM_q\(cat, p\) * m,\n           hi: TM_q\(cat, Math.min\(97, p+16\)\) * m };\n}\nfunction TM_ctx\(doc\){\n  var s = TM_state\(doc\);\n  var t = "At " + TM_money\(s.mid\) + " a month you would sit above " + Math.round\(s.p\) +\n          "% of the " + TM_N[s.cat] + " " + s.cat + " startups in this dataset. ";\n  if \(s.mid >= 2000\) t += "That clears the $2,000/month line only 33% of this entire dataset reaches. ";\n  else t += "That is below the $2,000/month line \204 you would need roughly " +\n            Math.ceil\(2000/Math.max\(s.mid,1\)\) + " times this outcome to reach it. ";\n  t += TM_Z[s.cat] + "% of " + s.cat + " startups here earned nothing at all last month.";\n  return t;\n}\n) /S /JavaScript >>
