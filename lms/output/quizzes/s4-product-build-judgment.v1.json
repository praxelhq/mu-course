          "text": "Show “Connected” after a timer so the flow feels complete"
        },
        {
          "option_id": "S4-Q2-PRESENTATION-ONLY",
          "canonical_order": 2,
          "text": "Remove the label but explain the mock in the final presentation"
        },
        {
          "option_id": "S4-Q2-PASTE-PASSWORD",
          "canonical_order": 3,
          "text": "Ask the student to paste their Instagram password"
