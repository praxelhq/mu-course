      "demand": "Product-selection judgment",
      "difficulty": null,
      "item_time_seconds": 45,
      "prompt": "Three products have credible revenue. Which is the strongest one-hour classroom target?",
      "response": {
        "type": "single_choice",
        "selected_option_field": "selectedOptionId"
      },
      "shuffle_options": true,
      "volatile": false,
      "stale_check_rule": "Revenue examples, not key",
      "options": [
        {
          "option_id": "S4-Q1-FEATURE-LIST",
          "canonical_order": 1,
          "text": "The one with the longest official feature list"
        },
        {
          "option_id": "S4-Q1-END-TO-END",
          "canonical_order": 2,
          "text": "The one whose valuable end-to-end behavior can be built and verified within the real constraints"
        },
        {
          "option_id": "S4-Q1-HIGHEST-MRR",
          "canonical_order": 3,
          "text": "The one with the highest MRR, regardless of architecture"
        },
        {
          "option_id": "S4-Q1-VISUAL",
          "canonical_order": 4,
          "text": "The one with the most visually impressive landing page"
        }
      ]
    },
    {
