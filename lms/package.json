{
  "name": "praxel-lms",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,worker -c blue,green \"pnpm dev\" \"pnpm worker:dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx prisma/seed.ts",
    "eval:grading": "tsx --env-file-if-exists=.env scripts/eval-grading.ts",
    "worker:dev": "tsx --env-file-if-exists=.env worker/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@clerk/nextjs": "^7.6.2",
    "@prisma/client": "^6.19.3",
    "next": "16.2.12",
    "pdf-parse": "^2.4.5",
    "pg-boss": "^12.26.3",
    "playwright": "^1.62.0",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "svix": "^1.99.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
