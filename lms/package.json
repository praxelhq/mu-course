{
  "name": "praxel-lms",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,worker -c blue,green \"pnpm dev\" \"pnpm worker:dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release:postgres": "node scripts/run-release-postgres-tests.mjs",
    "seed": "tsx prisma/seed.ts",
    "setup:sessions3-5": "tsx --env-file-if-exists=.env scripts/sessions3-5-setup.ts",
    "setup:sessions3-5:dry-run": "tsx --env-file-if-exists=.env scripts/sessions3-5-setup.ts --dry-run --report-json",
    "load:data-race": "tsx --env-file-if-exists=.env scripts/load-data-race.ts",
    "check:evaluator-boundary": "node scripts/check-evaluator-boundary.mjs",
    "check:evaluator-boundary:release": "node scripts/check-evaluator-boundary.mjs --require-private",
    "eval:grading": "tsx --env-file-if-exists=.env scripts/eval-grading.ts",
    "interview:simulate": "tsx --env-file-if-exists=.env scripts/interview-simulate.ts",
    "worker:dev": "tsx --env-file-if-exists=.env worker/index.ts",
    "e2e": "playwright test",
    "load:baseline": "k6 run scripts/load/k6-baseline.js",
    "load:quiz-burst": "k6 run scripts/load/k6-quiz-burst.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@clerk/nextjs": "^7.6.2",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@prisma/client": "^6.19.3",
    "@smithy/node-http-handler": "^4.9.12",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "next": "16.2.12",
    "pdf-parse": "^2.4.5",
    "pg-boss": "^12.26.3",
    "playwright": "^1.62.0",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "svix": "^1.99.1",
    "undici": "^8.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^20.19.43",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
