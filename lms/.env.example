# Postgres connection string used by Prisma and pg-boss
DATABASE_URL="postgresql://user:password@localhost:5432/praxel_lms_dev"

# Clerk publishable key (safe for the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# Clerk secret key (server-side API access)
CLERK_SECRET_KEY=""
# Clerk webhook signing secret (verifies user-sync webhooks)
CLERK_WEBHOOK_SECRET=""

# AWS credentials for S3 presigned URL generation
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# AWS region the S3 bucket lives in
AWS_REGION="ap-south-1"
# S3 bucket for all file storage (materials, submissions, interview audio)
S3_BUCKET=""

# Anthropic API key — grading calls, made from the queue worker only
ANTHROPIC_API_KEY=""
# Max concurrent grading jobs the worker will run
GRADING_CONCURRENCY=5

# Gemini API key — interview dialog model.
# Canonical name everywhere in this repo. The livekit google plugin used by
# the Python agent reads GOOGLE_API_KEY; agent/main.py maps
# GEMINI_API_KEY -> GOOGLE_API_KEY automatically, so only set this one.
GEMINI_API_KEY=""
# Deepgram API key — interview speech-to-text
DEEPGRAM_API_KEY=""
# ElevenLabs API key — interview text-to-speech
ELEVENLABS_API_KEY=""

# LiveKit server URL (wss://...) for interview audio transport
LIVEKIT_URL=""
# LiveKit API key
LIVEKIT_API_KEY=""
# LiveKit API secret
LIVEKIT_API_SECRET=""

# Shared secret authenticating the interview agent to internal LMS endpoints
AGENT_INTERNAL_TOKEN=""

# Dev only: enables the test-login backdoor. Never set in production.
ENABLE_TEST_LOGIN="false"

# Public base URL of the app (used for links, webhooks, redirects)
APP_URL="http://localhost:3000"
