# Postgres connection string used by Prisma and pg-boss
DATABASE_URL="postgresql://user:password@localhost:5432/praxel_lms_dev"

# Clerk publishable key (safe for the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# Clerk secret key (server-side API access)
CLERK_SECRET_KEY=""
# Clerk webhook signing secret (verifies user-sync webhooks)
CLERK_WEBHOOK_SECRET=""

# AWS credentials for S3 presigned URL generation
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# AWS region the S3 bucket lives in
AWS_REGION="ap-south-1"
# S3 bucket for all file storage (materials, submissions, interview audio)
S3_BUCKET=""

# Anthropic API key — grading calls, made from the queue worker only
ANTHROPIC_API_KEY=""
# Optional override of the grading model (default: claude-sonnet-4-5)
ANTHROPIC_MODEL=""
# Max concurrent grading jobs the worker will run
GRADING_CONCURRENCY=5

# Release-proof endpoint bearer token. Configure only through the secret store.
READINESS_TOKEN=""
# Durable worker identity cadence; readiness accepts at most two intervals old.
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
# Required in production: pg-boss retention schedule + matching expected interval.
RETENTION_CLEANUP_CRON="17 * * * *"
RETENTION_CLEANUP_INTERVAL_SECONDS=3600

# Gemini API key — interview dialog model.
# Canonical name everywhere in this repo. The livekit google plugin used by
# the Python agent reads GOOGLE_API_KEY; agent/main.py maps
# GEMINI_API_KEY -> GOOGLE_API_KEY automatically, so only set this one.
GEMINI_API_KEY=""
# Deepgram API key — interview speech-to-text
DEEPGRAM_API_KEY=""
# ElevenLabs API key — interview text-to-speech
ELEVENLABS_API_KEY=""

# LiveKit server URL (wss://...) for interview audio transport
LIVEKIT_URL=""
# LiveKit API key
LIVEKIT_API_KEY=""
# LiveKit API secret
LIVEKIT_API_SECRET=""

# Shared secret authenticating the interview agent to internal LMS endpoints
AGENT_INTERNAL_TOKEN=""
# Durable agent heartbeat cadence; bounded to 10–300 seconds.
AGENT_HEARTBEAT_INTERVAL_SECONDS=30

# Max concurrent realtime interview rooms before new students wait (default 30)
INTERVIEW_MAX_ROOMS="30"

# Dev only: enables the test-login backdoor. Never set in production.
ENABLE_TEST_LOGIN="false"

# Public base URL of the app (used for links, webhooks, redirects)
APP_URL="http://localhost:3000"

# --- Shipyard (Course 2) ---------------------------------------------------
# OpenRouter is the ONLY AI gateway the Shipyard uses (lib/ai/openrouter.ts).
# Unset: every call falls back to the deterministic fake responder, so `pnpm
# seed`, the tests and the demo stack run with no key and no spend.
OPENROUTER_API_KEY=""
# Routing profile at boot: flash-verdicts (default) or flash-everywhere.
# Once the BYOK kill-switch has fired, ShipyardRouterState in the DB wins.
OPENROUTER_ROUTING_PROFILE="flash-verdicts"
# Reviewer concurrency. 15 drains 480 deadline-night submissions in ~25 min.
SHIPYARD_REVIEW_CONCURRENCY=15
# Headless-render budget for a checkpoint 3 live URL, milliseconds.
SHIPYARD_RENDER_TIMEOUT_MS=20000

# Shipped.money (the tracker) — the ONLY source of a student's real numbers.
# "fake" reads the ShipyardTrackerOverride table so metric gates can be
# demonstrated with no live tracker; "real" speaks HTTP. Unset means "real"
# only when SHIPPED_MONEY_BASE_URL is set.
TRACKER_MODE="fake"
# Live tracker: https://web-production-f46c6.up.railway.app
# Left empty on purpose until its /api/v1/checkpoint-signals endpoint ships.
SHIPPED_MONEY_BASE_URL=""
# Service token: the bearer AND the HMAC-SHA256 key for X-Shipyard-Signature.
SHIPPED_MONEY_SERVICE_TOKEN=""
