# Staging/demo image: runs the app in DEVELOPMENT mode so the dev-only
# test-login route works (the production Dockerfile.web deliberately forbids
# it). Single stage, keeps dev deps (tsx for seed, next dev), installs
# openssl so Prisma's query engine runs on the slim base.
FROM node:22-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable
WORKDIR /app

# Build context is the lms/ dir (service rootDirectory=lms).
COPY package.json pnpm-lock.yaml ./
COPY prisma ./prisma
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm prisma generate

ENV NODE_ENV=development
ENV PORT=3000
EXPOSE 3000

# migrate -> seed demo world -> serve in dev mode
CMD ["sh","-c","pnpm prisma migrate deploy && (pnpm seed || echo 'seed skipped') && pnpm exec next dev -p ${PORT:-3000} -H 0.0.0.0"]
