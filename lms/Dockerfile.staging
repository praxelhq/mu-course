# syntax=docker/dockerfile:1
# Production-like staging web image. It deliberately uses the same standalone
# build, migration-owning entrypoint, and NODE_ENV as production. Course
# loaders are explicit one-off jobs; test-login and automatic seed are absent.

FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH" \
    NEXT_TELEMETRY_DISABLED=1
RUN corepack enable

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM base AS build
WORKDIR /app
ARG RAILWAY_GIT_COMMIT_SHA=unknown
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN printf '%s\n' "$RAILWAY_GIT_COMMIT_SHA" > /app/BUILD_SOURCE_SHA
RUN pnpm prisma generate
RUN pnpm build

FROM node:22-slim AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g prisma@6.19.3
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
COPY --from=build /app/course/session-08 ./course/session-08
COPY --from=build /app/BUILD_SOURCE_SHA ./BUILD_SOURCE_SHA
COPY prisma ./prisma
COPY docker-entrypoint.web.sh ./docker-entrypoint.web.sh
RUN chmod +x ./docker-entrypoint.web.sh
EXPOSE 3000
CMD ["./docker-entrypoint.web.sh"]
